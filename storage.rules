rules_version = '2';

// Firebase Storage 보안 규칙
//
// 주간보고 첨부파일만 다룬다. 그 외 경로는 전부 차단한다.
// 역할·담당 지점 판단은 Firestore 의 users 문서를 읽어서 한다
// (Firestore 규칙과 같은 기준을 쓰기 위해서다).
//
// ⚠ 교차 서비스(Storage → Firestore) 호출 한도
//    "Maximum number of firestore.exists() and firestore.get() calls per request: 2.
//     Exceeding this limit results in a permission denied error."
//
//    이 한도를 넘으면 프로필이 멀쩡해도 무조건 거부된다.
//    그래서 평가 한 번에 firestore.get 을 정확히 한 번만 호출한다.
//    role / status / branchIds 를 각각 조회하면 3회가 되어 한도를 넘는다.
//    let 으로 한 번 읽어 세 가지를 모두 거기서 본다.
//
// ⚠ 이 기능은 IAM 권한이 있어야 동작한다.
//    Storage 서비스 계정(service-<프로젝트번호>@gcp-sa-firebasestorage.iam.gserviceaccount.com)에
//    "Firebase Rules Firestore Service Agent" 역할이 필요하다.
//    없으면 firestore.get 이 실패해 역시 전부 거부된다.
//
// 다운로드 URL 토큰에 대하여
//    getDownloadURL() 이 돌려주는 URL 은 토큰이 붙어 있어 그 자체로는 인증 없이 열린다.
//    그래서 URL 을 Firestore 에 저장하지 않고, 아래 read 규칙을 통과한 사용자에게만
//    조회 시점에 발급한다.

service firebase.storage {
  match /b/{bucket}/o {

    // 조회 권한 — firestore.get 1회.
    // 본사(admin)는 전 지점, 지점장은 담당 지점만.
    function canRead(branchId) {
      let p = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      return p.status == 'active'
        && (p.role == 'admin'
          || (p.role == 'branch_manager' && branchId in p.branchIds));
    }

    // 업로드 권한 — firestore.get 1회. 담당 지점장만.
    function canWrite(branchId) {
      let p = firestore.get(/databases/(default)/documents/users/$(request.auth.uid)).data;
      return p.role == 'branch_manager'
        && p.status == 'active'
        && branchId in p.branchIds;
    }

    // 업로드 허용 형식 — 클라이언트가 확장자·시그니처 검증 후
    // 표준 contentType 을 직접 지정해 올린다.
    function allowedContentType() {
      return request.resource.contentType in [
        'application/pdf',
        'application/vnd.openxmlformats-officedocument.spreadsheetml.sheet',
        'application/vnd.ms-excel',
        'application/vnd.openxmlformats-officedocument.wordprocessingml.document'
      ];
    }

    // 이어올리기 단계에서 size 가 아직 안 채워질 수 있어 상한만 본다.
    function withinSizeLimit() {
      return request.resource.size <= 20 * 1024 * 1024;
    }

    // ─── 주간보고 첨부파일 ───────────────────────────────────────────────
    // 경로: branchWeeklyReports/{branchId}/{weekStartDate}/{fileName}
    match /branchWeeklyReports/{branchId}/{weekStartDate}/{fileName} {
      allow read: if request.auth != null && canRead(branchId);

      // create/update 와 delete 를 나눈다. 삭제 요청에는 request.resource 가 없어
      // contentType·size 검사에 걸려 엉뚱하게 거부될 수 있다.
      allow create, update: if request.auth != null
        && canWrite(branchId)
        && allowedContentType()
        && withinSizeLimit();

      // 삭제는 담당 지점장 또는 본사(정리 목적)
      allow delete: if request.auth != null && canRead(branchId);
    }

    // 그 외 모든 경로 차단
    match /{allPaths=**} {
      allow read, write: if false;
    }
  }
}
