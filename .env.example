NEXT_PUBLIC_FIREBASE_API_KEY=
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=returnoneday.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=returnoneday
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=returnoneday.firebasestorage.app
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=
NEXT_PUBLIC_FIREBASE_APP_ID=

# Firebase Admin SDK (scripts only — never commit actual values)
FIREBASE_ADMIN_PROJECT_ID=
FIREBASE_ADMIN_CLIENT_EMAIL=
FIREBASE_ADMIN_PRIVATE_KEY=

# Seed scripts
TEST_MANAGER_UID=

# ─── Gemini 챗봇 ─────────────────────────────────────────────
# ⚠ NEXT_PUBLIC_ 을 절대 붙이지 말 것.
#   붙이면 키가 클라이언트 번들에 그대로 들어가 브라우저에서 누구나 볼 수 있다.
#   이 키는 app/api/chat/route.ts (서버)에서만 읽는다.
#
# 키 발급: https://aistudio.google.com/apikey
GEMINI_API_KEY=

# 사용할 모델 (비워두면 gemini-2.5-flash)
# 실제 사용 가능한 모델은 `npm run gemini:models` 로 확인한다.
GEMINI_MODEL=
